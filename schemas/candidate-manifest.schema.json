          "type": "number"
        },
        "expert": {
          "minimum": 0,
          "title": "Expert",
          "type": "integer"
        },
        "layer": {
          "minimum": 0,
          "title": "Layer",
          "type": "integer"
        }
      },
      "required": [
        "layer",
        "expert",
        "differential"
      ],
      "title": "CandidateExpert",
      "type": "object"
    }
  },
  "additionalProperties": false,
