{
  "$defs": {
    "BridgeExpertMapping": {
      "additionalProperties": false,
      "description": "Explicit mapping from one donor expert to one host MLP sidecar layer.",
      "properties": {
        "donor_expert": {
          "minimum": 0,
          "title": "Donor Expert",
          "type": "integer"
        },
        "donor_layer": {
          "minimum": 0,
          "title": "Donor Layer",
          "type": "integer"
        },
        "host_layer": {
          "minimum": 0,
          "title": "Host Layer",
          "type": "integer"
        }
      },
      "required": [
        "donor_layer",
        "donor_expert",
        "host_layer"
      ],
      "title": "BridgeExpertMapping",
      "type": "object"
    },
    "BridgeTrainingRow": {
      "additionalProperties": false,
      "description": "Reference into an immutable target shard plus a host state row.",
      "properties": {
        "domain": {
          "enum": [
            "coding",
            "control"
          ],
          "title": "Domain",
          "type": "string"
        },
        "donor_expert": {
          "minimum": 0,
          "title": "Donor Expert",
          "type": "integer"
        },
        "donor_layer": {
          "minimum": 0,
          "title": "Donor Layer",
          "type": "integer"
        },
        "event_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Event Id",
          "type": "string"
        },
        "host_layer": {
          "minimum": 0,
          "title": "Host Layer",
          "type": "integer"
        },
        "host_state_row": {
          "minimum": 0,
          "title": "Host State Row",
          "type": "integer"
        },
        "route_rank": {
          "minimum": 0,
          "title": "Route Rank",
          "type": "integer"
        },
        "router_weight": {
          "minimum": 0,
          "title": "Router Weight",
          "type": "number"
        },
        "row_index": {
          "minimum": 0,
          "title": "Row Index",
          "type": "integer"
        },
        "sample_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sample Content Sha256",
          "type": "string"
        },
        "sample_id": {
          "minLength": 1,
          "title": "Sample Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "shard_path": {
          "minLength": 1,
          "title": "Shard Path",
          "type": "string"
        },
        "split": {
          "enum": [
            "train",
            "validation",
            "test"
          ],
          "title": "Split",
          "type": "string"
        },
        "token_id": {
          "minimum": 0,
          "title": "Token Id",
          "type": "integer"
        },
        "token_position": {
          "minimum": 0,
          "title": "Token Position",
          "type": "integer"
        }
      },
      "required": [
        "event_id",
        "shard_path",
        "row_index",
        "host_state_row",
        "sample_id",
        "sample_content_sha256",
        "domain",
        "split",
        "token_position",
        "token_id",
        "donor_layer",
        "donor_expert",
        "host_layer",
        "route_rank",
        "router_weight"
      ],
      "title": "BridgeTrainingRow",
      "type": "object"
    },
    "BridgeUnusedRow": {
      "additionalProperties": false,
      "description": "A valid source row deliberately excluded, with a machine-readable reason.",
      "properties": {
        "domain": {
          "enum": [
            "coding",
            "control"
          ],
          "title": "Domain",
          "type": "string"
        },
        "donor_expert": {
          "minimum": 0,
          "title": "Donor Expert",
          "type": "integer"
        },
        "donor_layer": {
          "minimum": 0,
          "title": "Donor Layer",
          "type": "integer"
        },
        "event_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Event Id",
          "type": "string"
        },
        "reason": {
          "enum": [
            "missing-host-state",
            "per-sample-cap",
            "invalid-token-alignment"
          ],
          "title": "Reason",
          "type": "string"
        },
        "row_index": {
          "minimum": 0,
          "title": "Row Index",
          "type": "integer"
        },
        "sample_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sample Content Sha256",
          "type": "string"
        },
        "sample_id": {
          "minLength": 1,
          "title": "Sample Id",
          "type": "string"
        },
        "shard_path": {
          "minLength": 1,
          "title": "Shard Path",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "shard_path",
        "row_index",
        "sample_id",
        "sample_content_sha256",
        "donor_layer",
        "donor_expert",
        "domain",
        "reason"
      ],
      "title": "BridgeUnusedRow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Frozen, sample-grouped split and row-reference manifest.",
  "properties": {
    "candidate_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Manifest Sha256",
      "type": "string"
    },
    "capture_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Capture Manifest Sha256",
      "type": "string"
    },
    "capture_outcome": {
      "enum": [
        "coverage-complete",
        "coverage-incomplete"
      ],
      "title": "Capture Outcome",
      "type": "string"
    },
    "cell_counts": {
      "additionalProperties": {
        "additionalProperties": {
          "type": "integer"
        },
        "type": "object"
      },
      "title": "Cell Counts",
      "type": "object"
    },
    "extraction_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Extraction Manifest Sha256",
      "type": "string"
    },
    "handoff_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Handoff Manifest Sha256",
      "type": "string"
    },
    "host_states_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Host States Manifest Sha256",
      "type": "string"
    },
    "kind": {
      "const": "bridge-training-manifest",
      "title": "Kind",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "mappings": {
      "items": {
        "$ref": "#/$defs/BridgeExpertMapping"
      },
      "minItems": 1,
      "title": "Mappings",
      "type": "array"
    },
    "max_rows_per_sample": {
      "exclusiveMinimum": 0,
      "title": "Max Rows Per Sample",
      "type": "integer"
    },
    "min_events_per_cell": {
      "exclusiveMinimum": 0,
      "title": "Min Events Per Cell",
      "type": "integer"
    },
    "min_samples_per_cell": {
      "exclusiveMinimum": 0,
      "title": "Min Samples Per Cell",
      "type": "integer"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/BridgeTrainingRow"
      },
      "minItems": 1,
      "title": "Rows",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "seed": {
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "source_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Manifest Sha256",
      "type": "string"
    },
    "split_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Split Counts",
      "type": "object"
    },
    "unused_rows": {
      "items": {
        "$ref": "#/$defs/BridgeUnusedRow"
      },
      "title": "Unused Rows",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "handoff_manifest_sha256",
    "capture_manifest_sha256",
    "source_manifest_sha256",
    "candidate_manifest_sha256",
    "extraction_manifest_sha256",
    "host_states_manifest_sha256",
    "mappings",
    "split_counts",
    "cell_counts",
    "rows",
    "seed",
    "min_samples_per_cell",
    "max_rows_per_sample",
    "min_events_per_cell",
    "capture_outcome",
    "manifest_sha256"
  ],
  "title": "BridgeTrainingManifest",
  "type": "object"
}
