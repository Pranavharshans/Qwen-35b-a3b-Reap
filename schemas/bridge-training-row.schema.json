{
  "additionalProperties": false,
  "description": "Reference into an immutable target shard plus a host state row.",
  "properties": {
    "domain": {
      "enum": [
        "coding",
        "control"
      ],
      "title": "Domain",
      "type": "string"
    },
    "donor_expert": {
      "minimum": 0,
      "title": "Donor Expert",
      "type": "integer"
    },
    "donor_layer": {
      "minimum": 0,
      "title": "Donor Layer",
      "type": "integer"
    },
    "event_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Event Id",
      "type": "string"
    },
    "host_layer": {
      "minimum": 0,
      "title": "Host Layer",
      "type": "integer"
    },
    "host_state_row": {
      "minimum": 0,
      "title": "Host State Row",
      "type": "integer"
    },
    "route_rank": {
      "minimum": 0,
      "title": "Route Rank",
      "type": "integer"
    },
    "router_weight": {
      "minimum": 0,
      "title": "Router Weight",
      "type": "number"
    },
    "row_index": {
      "minimum": 0,
      "title": "Row Index",
      "type": "integer"
    },
    "sample_content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sample Content Sha256",
      "type": "string"
    },
    "sample_id": {
      "minLength": 1,
      "title": "Sample Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "shard_path": {
      "minLength": 1,
      "title": "Shard Path",
      "type": "string"
    },
    "split": {
      "enum": [
        "train",
        "validation",
        "test"
      ],
      "title": "Split",
      "type": "string"
    },
    "token_id": {
      "minimum": 0,
      "title": "Token Id",
      "type": "integer"
    },
    "token_position": {
      "minimum": 0,
      "title": "Token Position",
      "type": "integer"
    }
  },
  "required": [
    "event_id",
    "shard_path",
    "row_index",
    "host_state_row",
    "sample_id",
    "sample_content_sha256",
    "domain",
    "split",
    "token_position",
    "token_id",
    "donor_layer",
    "donor_expert",
    "host_layer",
    "route_rank",
    "router_weight"
  ],
  "title": "BridgeTrainingRow",
  "type": "object"
}
