{
  "$defs": {
    "BridgeCaptureExpert": {
      "additionalProperties": false,
      "description": "Stable donor layer/expert identity.",
      "properties": {
        "expert": {
          "minimum": 0,
          "title": "Expert",
          "type": "integer"
        },
        "layer": {
          "minimum": 0,
          "title": "Layer",
          "type": "integer"
        }
      },
      "required": [
        "layer",
        "expert"
      ],
      "title": "BridgeCaptureExpert",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Hash inventory crossing from the donor VM to later bridge training.",
  "properties": {
    "analyzed_tokens": {
      "minimum": 0,
      "title": "Analyzed Tokens",
      "type": "integer"
    },
    "artifacts": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    },
    "bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Bundle Sha256",
      "type": "string"
    },
    "candidate_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Manifest Sha256",
      "type": "string"
    },
    "capture_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Capture Manifest Sha256",
      "type": "string"
    },
    "config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "extraction_artifact": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Extraction Artifact"
    },
    "kind": {
      "const": "bridge-target-handoff",
      "title": "Kind",
      "type": "string"
    },
    "record_count": {
      "minimum": 0,
      "title": "Record Count",
      "type": "integer"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "target_experts": {
      "items": {
        "$ref": "#/$defs/BridgeCaptureExpert"
      },
      "minItems": 1,
      "title": "Target Experts",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "run_id",
    "capture_manifest_sha256",
    "config_sha256",
    "candidate_manifest_sha256",
    "target_experts",
    "artifacts",
    "record_count",
    "analyzed_tokens",
    "bundle_sha256"
  ],
  "title": "BridgeTargetBundle",
  "type": "object"
}
